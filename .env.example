# Database Configuration for ChatBiz

# To use MySQL database, set DB_ENGINE=mysql and provide connection details:
# DB_ENGINE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=chatbiz

# Alternatively, specify full SQLAlchemy / PyMySQL connection URL:
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/chatbiz

# Default local development fallback (SQLite):
DATABASE_URL=sqlite:///./chatbiz.db
